<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>DekoSchätze · Mix & Match V8</title><style>
*{box-sizing:border-box}body{margin:0;background:#f7f4f0;color:#483b32;font:14px system-ui,Arial}header{background:white;border-bottom:1px solid #e9e1d8;padding:17px 24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px}h1{font:32px Georgia;margin:0}h2{font:23px Georgia;margin:0 0 14px}small,.muted{color:#82756b}main{max-width:1450px;margin:20px auto;padding:0 16px;display:grid;grid-template-columns:minmax(350px,1.15fr) minmax(330px,1fr);gap:18px}.card{background:#fff;border:1px solid #e6dcd1;border-radius:16px;padding:17px;min-width:0}.buttons{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}button,input,select,textarea{font:inherit}button{border:1px solid #d8c8b7;background:#fff;color:#47372d;padding:9px 12px;border-radius:9px;cursor:pointer}button:hover{background:#f5eae0}button.active,.primary{background:#896749;color:#fff;border-color:#896749}.primary:hover{background:#76553a}.scene{position:relative;aspect-ratio:5/6;width:100%;max-width:660px;margin:auto;background:#fff center/100% 100% no-repeat;border-radius:12px;overflow:hidden;touch-action:none;border:1px solid #eee}.piece{position:absolute;transform:translate(-50%,-50%);cursor:grab;touch-action:none;user-select:none;border:2px solid transparent;border-radius:8px;display:flex;align-items:center;justify-content:center}.piece img{display:block;width:100%;height:100%;object-fit:contain;pointer-events:none;filter:drop-shadow(1px 3px 2px #0004)}.piece.selected{border:2px dashed #ad845b;background:#fffcf020}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.product{min-width:0;min-height:119px;padding:6px;font-size:11px;line-height:1.3;display:flex;align-items:center;flex-direction:column;justify-content:center}.product img{width:100%;height:78px;object-fit:contain}.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center}.toolbar label{display:flex;align-items:center;gap:6px}.summary{max-height:225px;overflow:auto}.summary div{display:flex;justify-content:space-between;gap:8px;padding:6px 0;border-bottom:1px solid #eee6dc}.field{display:grid;gap:5px;margin:10px 0}.field input,.field textarea,.field select{width:100%;padding:10px;border:1px solid #d8c8b7;border-radius:8px;background:white}.pill{display:inline-block;background:#eee3d7;border-radius:30px;padding:5px 10px;font-size:12px}.tabs{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 14px}.tabs button{font-size:12px}.notice{background:#f8f3ed;border-radius:10px;padding:11px;margin:12px 0;line-height:1.5}.columns{display:grid;grid-template-columns:1fr 1fr;gap:10px}.row{display:flex;align-items:center;justify-content:space-between;gap:8px}input[type=range]{width:130px}.sticky{position:sticky;top:10px;align-self:start}@media(max-width:850px){main{grid-template-columns:1fr}.sticky{position:static}.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:430px){main{padding:0 8px}.card{padding:12px}.columns{grid-template-columns:1fr}}
</style></head><body><header><div><h1>DekoSchätze <small style="font:12px system-ui">MIX & MATCH</small></h1><small>Deinen Wunschtisch gestalten · Version 8</small></div><span class="pill">Deine Tischdeko. Dein Stil.</span></header><main><section class="card sticky"><h2>Dein Wunschtisch</h2><div class="buttons"><button id="long" class="active">Lange Tafel</button><button id="round">Runder Tisch</button><button id="save">Bild speichern</button><button id="clear">Tisch leeren</button></div><div id="scene" class="scene"></div><div class="notice">Artikel anklicken und mit Maus oder Finger verschieben. Die Größen sind eine visuelle Vorschau, keine maßstabsgetreue 3D-Darstellung.</div><div class="toolbar"><strong id="selname">Artikel auswählen</strong><button id="left">↶ Drehen</button><button id="right">↷ Drehen</button><label>Größe <input id="scale" type="range" min="35" max="210" value="100"></label><button id="remove">Entfernen</button></div></section><aside><section class="card"><h2>Deine Dekoration</h2><div class="tabs"><button id="tabcatalog" class="active">Einzelartikel</button><button id="tabconcept">Fertige Konzepte</button><button id="tabnapkin">Serviette + Ring</button></div><div id="catalogview"><div class="field"><label>Artikel suchen</label><input id="search" placeholder="z. B. Vase, Serviette, Kerzenhalter"></div><div id="catalog" class="grid"></div></div><div id="conceptview" hidden><p>Ein fertiges Konzept für <b>8,90 € pro Gast</b> auswählen. Die Artikelauswahl wird als editierbare Vorschau geladen.</p><div id="concepts" class="grid" style="grid-template-columns:repeat(2,1fr)"></div><p class="muted">Nach individuellen Änderungen ist der Konzeptpreis nicht automatisch verbindlich.</p></div><div id="napkinview" hidden><p>Serviette und Ring getrennt wählen – anschließend als <b>eine gemeinsam verschiebbare Gruppe</b> auf den Tisch setzen.</p><div class="field"><label>Serviette</label><select id="napkin"></select></div><div class="field"><label>Serviettenring</label><select id="ring"></select></div><button class="primary" id="addpair">Kombination hinzufügen</button><p class="muted">Die Ringe werden als eigene Ebene auf der Serviette dargestellt und bleiben in der Artikelliste separat ausgewiesen.</p></div></section><section class="card" style="margin-top:15px"><div class="row"><h2>Meine Auswahl</h2><span class="pill" id="count">0 Artikel</span></div><div id="summary" class="summary"></div><div class="field"><label>Gästezahl</label><input id="guests" type="number" min="1" max="1000" value="10"></div><div class="field"><label>Preis-Modell</label><select id="priceMode"><option value="concept">Fertiges Konzept – 8,90 € / Gast</option><option value="mix">Individuelles Mix & Match – Preis auf Anfrage</option></select></div><div id="price" class="notice"></div><button id="copy">Artikelliste kopieren</button></section><section class="card" style="margin-top:15px"><h2>Unverbindlich anfragen</h2><p class="muted">Deine Zusammenstellung wird in eine E-Mail übernommen. Bitte das gespeicherte Tischbild bei Bedarf als Anhang hinzufügen.</p><form id="inquiry"><div class="columns"><div class="field"><label>Name *</label><input id="customer" required></div><div class="field"><label>E-Mail *</label><input id="email" type="email" required></div></div><div class="columns"><div class="field"><label>Veranstaltungsdatum</label><input id="date" type="date"></div><div class="field"><label>Telefon (optional)</label><input id="phone" type="tel"></div></div><div class="field"><label>Nachricht</label><textarea id="message" rows="3" placeholder="Wünsche oder Fragen"></textarea></div><div class="field"><label>Empfängeradresse für die Anfrage</label><input id="recipient" type="email" placeholder="E-Mail-Adresse von DekoSchätze eingeben" required></div><button class="primary" type="submit">E-Mail-Anfrage vorbereiten</button></form><p class="muted">Dies öffnet dein E-Mail-Programm; es wird nichts automatisch versendet. Eine spätere Online-Anfrage mit automatischer Zustellung benötigt eine Server-Anbindung.</p></section></aside></main><script>
const pictures=["data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/webp;base64,","data:image/svg+xml;base64,","data:image/svg+xml;base64,","data:image/svg+xml;base64,","data:image/svg+xml;base64,","data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxODAiIGhlaWdodD0iMTEwIiB2aWV3Qm94PSIwIDAgMTgwIDExMCI+PGVsbGlwc2UgY3g9IjkwIiBjeT0iNTUiIHJ4PSI1NiIgcnk9IjI1IiBmaWxsPSJub25lIiBzdHJva2U9IiNjZGEzNGYiIHN0cm9rZS13aWR0aD0iMTYiLz48L3N2Zz4=","data:image/svg+xml;base64,","data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIxODAiIGhlaWdodD0iMTEwIiB2aWV3Qm94PSIwIDAgMTgwIDExMCI+PGVsbGlwc2UgY3g9IjkwIiBjeT0iNTUiIHJ4PSI1NiIgcnk9IjI1IiBmaWxsPSJub25lIiBzdHJva2U9IiNhNDdhNGIiIHN0cm9rZS13aWR0aD0iMTYiLz48L3N2Zz4="];const labels=["Beiger Tischstoff","Geknotete Serviette","Kerzenhalter hoch","Kerzenhalter mittel","Kerzenhalter klein","Glaszylinder hoch","Glaszylinder mittel","Glaszylinder klein","Geflochtenes Platzset","Goldene Teelichthalter 1","Goldene Teelichthalter 2","Goldene Teelichthalter 3","Goldene Stabkerzenhalter 1","Goldene Stabkerzenhalter 2","Serviette Olivgrün mit Ring","Stoff Salbeigrün","Glaszylinder mit Kerze 1","Glaszylinder mit Kerze 2","Glaszylinder mit Kerze 3","Glaszylinder mit Kerze 4","Glaskerzenhalter 1","Glaskerzenhalter 2","Glaskerzenhalter 3","Glaskerzenhalter 4","Serviette Weiß mit Perlenring","Serviette Terracotta mit Jutering","Klare Glasvasen 1","Klare Glasvasen 2","Klare Glasvasen 3","Klare Glasvasen 4","Glaskerzenhalter mit Kerze 1","Glaskerzenhalter mit Kerze 2","Rosé Glasvasen 1","Rosé Glasvasen 2","Rosé Glasvasen 3","Rosé Glasvasen 4","Geriffelte Teelichtgläser 1","Geriffelte Teelichtgläser 2","Geriffelte Teelichtgläser 3","Geriffelte Teelichtgläser 4","Serviette Salbeigrün (ohne Ring)","Serviette Terracotta (ohne Ring)","Serviette Weiß (ohne Ring)","Serviette Beige (ohne Ring)","Serviettenring Gold","Serviettenring Perlen","Serviettenring Jute"];const backgrounds={"long":"data:image/jpeg;base64,","round":"data:image/jpeg;base64,"};const sizes=[33,13,8,7,6,10,9,8,14,8,8,8,8,8,12,12,8,8,8,8,8,8,8,8,12,12,8,8,8,8,8,8,8,8,8,8,10,10,10,10,11,11,11,11,6,6,6];const ratios=[1.4979757085020242,0.7486486486486487,0.26216216216216215,0.26216216216216215,0.25675675675675674,0.4648648648648649,0.46756756756756757,0.4540540540540541,1,0.914,0.878,1.011,0.403,0.308,0.55,1.309,0.189,0.364,0.364,0.189,0.319,0.514,0.506,0.317,0.669,0.556,0.675,0.694,0.528,0.508,0.275,0.272,0.603,0.781,0.761,0.586,0.783,0.875,0.892,0.764,0.75,0.75,0.75,0.75,1.6363636363636365,1.6363636363636365,1.6363636363636365];
let shape='long',items=[],selected=null,seq=0,drag=null,activeConcept='',changed=false;
const $=id=>document.getElementById(id),scene=$('scene');
function add(kind,x,y,ringKind=null){const n=items.length;let item={id:++seq,kind,ringKind,x:x??(44+(n%4)*4),y:y??(39+(Math.floor(n/4)%4)*5),scale:100,angle:0};items.push(item);selected=item.id;if(activeConcept)changed=true;render()}
function render(){scene.style.backgroundImage=`url("${backgrounds[shape]}")`;scene.querySelectorAll('.piece').forEach(e=>e.remove());items.forEach(it=>{let div=document.createElement('div');div.className='piece'+(selected===it.id?' selected':'');div.dataset.id=it.id;div.style.left=it.x+'%';div.style.top=it.y+'%';div.style.width=(sizes[it.kind]*it.scale/100)+'%';div.style.aspectRatio=String(ratios[it.kind]);div.style.transform=`translate(-50%,-50%) rotate(${it.angle}deg)`;let img=new Image();img.src=pictures[it.kind];div.append(img);if(it.ringKind!==null){let ring=new Image();ring.src=pictures[it.ringKind];ring.style.position='absolute';ring.style.width='55%';ring.style.height='34%';ring.style.top='34%';ring.style.left='22%';ring.style.objectFit='contain';ring.style.filter='drop-shadow(1px 2px 2px #0004)';div.append(ring)}scene.append(div)});let cur=items.find(x=>x.id===selected);$('selname').textContent=cur?labels[cur.kind]+(cur.ringKind!==null?' + '+labels[cur.ringKind]:''):'Artikel auswählen';$('scale').value=cur?cur.scale:100;$('count').textContent=items.length+' Positionen';let counts={};items.forEach(it=>{counts[it.kind]=(counts[it.kind]||0)+1;if(it.ringKind!==null)counts[it.ringKind]=(counts[it.ringKind]||0)+1});$('summary').innerHTML=Object.entries(counts).map(([k,v])=>'<div><span>'+labels[k]+'</span><b>'+v+' ×</b></div>').join('')||'<p class="muted">Noch keine Artikel.</p>';price()}
function price(){let n=Math.max(1,Number($('guests').value)||1);let concept=$('priceMode').value==='concept';$('price').textContent=concept&&!changed&&activeConcept?`${activeConcept}: ${n} Gäste × 8,90 € = ${(n*8.9).toLocaleString('de-DE',{style:'currency',currency:'EUR'})} (unverbindliche Orientierung; Verfügbarkeit prüfen)`:'Individuelles Mix & Match: Preis auf Anfrage. Einzelmietpreise sind noch nicht hinterlegt.'}
function selectShape(v){shape=v;$('long').classList.toggle('active',v==='long');$('round').classList.toggle('active',v==='round');render()}
$('long').onclick=()=>selectShape('long');$('round').onclick=()=>selectShape('round');$('clear').onclick=()=>{items=[];selected=null;activeConcept='';changed=false;render()};$('remove').onclick=()=>{items=items.filter(x=>x.id!==selected);selected=null;changed=true;render()};$('left').onclick=()=>turn(-15);$('right').onclick=()=>turn(15);function turn(n){let it=items.find(x=>x.id===selected);if(it){it.angle+=n;changed=true;render()}}$('scale').oninput=e=>{let it=items.find(x=>x.id===selected);if(it){it.scale=Number(e.target.value);changed=true;render()}};
scene.addEventListener('pointerdown',e=>{let el=e.target.closest('.piece');if(!el){selected=null;render();return}selected=Number(el.dataset.id);let it=items.find(x=>x.id===selected),r=scene.getBoundingClientRect();drag={id:selected,dx:(e.clientX-r.left)/r.width*100-it.x,dy:(e.clientY-r.top)/r.height*100-it.y};scene.setPointerCapture(e.pointerId);render()});scene.addEventListener('pointermove',e=>{if(!drag)return;let it=items.find(x=>x.id===drag.id),r=scene.getBoundingClientRect();if(!it)return;it.x=Math.max(3,Math.min(97,(e.clientX-r.left)/r.width*100-drag.dx));it.y=Math.max(3,Math.min(97,(e.clientY-r.top)/r.height*100-drag.dy));changed=true;render()});scene.addEventListener('pointerup',()=>drag=null);scene.addEventListener('pointercancel',()=>drag=null);
function catalog(){let q=$('search').value.toLocaleLowerCase('de');$('catalog').replaceChildren();labels.forEach((label,i)=>{if(!label.toLocaleLowerCase('de').includes(q))return;let b=document.createElement('button');b.className='product';let img=new Image();img.src=pictures[i];b.append(img,document.createTextNode(label));b.onclick=()=>add(i);$('catalog').append(b)})}
$('search').oninput=catalog;catalog();
const napkins=labels.map((v,i)=>({v,i})).filter(o=>/Serviette|Stoff Salbeigrün/i.test(o.v)&&!/Ring\)/i.test(o.v));const rings=labels.map((v,i)=>({v,i})).filter(o=>/Serviettenring (Gold|Perlen|Jute)/i.test(o.v));for(let [id,list] of [['napkin',napkins],['ring',rings]])list.forEach(o=>{let opt=document.createElement('option');opt.value=o.i;opt.textContent=o.v;$(id).append(opt)});$('addpair').onclick=()=>add(Number($('napkin').value),undefined,undefined,Number($('ring').value));
for(let [tab,view] of [['tabcatalog','catalogview'],['tabconcept','conceptview'],['tabnapkin','napkinview']])$(tab).onclick=()=>{for(let [t,v] of [['tabcatalog','catalogview'],['tabconcept','conceptview'],['tabnapkin','napkinview']]){$(t).classList.toggle('active',t===tab);$(v).hidden=t!==tab}};
const concepts={'Amber Glow':[[1,28,25],[8,40,65],[2,48,39],[3,55,51],[4,48,64]],'Natural Glow':[[0,50,45],[5,47,35],[6,55,50],[7,48,65],[8,25,23]],'Forest Gold':[[42,25,28],[2,50,36],[3,54,52],[4,48,65],[9,44,44]],'Chrystal White':[[43,25,28],[5,47,37],[6,54,53],[7,48,65],[8,75,26]]};Object.entries(concepts).forEach(([name,layout])=>{let b=document.createElement('button');b.style.minHeight='72px';b.innerHTML='<strong>'+name+'</strong><br><small>8,90 € / Gast</small>';b.onclick=()=>{items=[];selected=null;activeConcept=name;changed=false;layout.forEach(([kind,x,y])=>{items.push({id:++seq,kind,x,y,ringKind:null,scale:100,angle:0})});$('priceMode').value='concept';render()};$('concepts').append(b)});
$('guests').oninput=price;$('priceMode').onchange=price;
function summaryText(){let counts={};items.forEach(it=>{counts[it.kind]=(counts[it.kind]||0)+1;if(it.ringKind!==null)counts[it.ringKind]=(counts[it.ringKind]||0)+1});return `DekoSchätze – Anfrage
Tisch: ${shape==='long'?'Lange Tafel':'Runder Tisch'}
Gäste: ${$('guests').value}
Modell: ${$('priceMode').value==='mix'?'Individuelles Mix & Match':(activeConcept||'Fertiges Konzept')}
${$('price').textContent}
Artikel:
`+Object.entries(counts).map(([k,v])=>`${v} × ${labels[k]}`).join('\\n')}
$('copy').onclick=async()=>{try{await navigator.clipboard.writeText(summaryText());alert('Artikelliste kopiert.')}catch(e){window.prompt('Zum Kopieren:',summaryText())}};
async function saveImage(){let canvas=document.createElement('canvas');canvas.width=750;canvas.height=900;let ctx=canvas.getContext('2d');let bg=new Image();bg.src=backgrounds[shape];await bg.decode();ctx.drawImage(bg,0,0,750,900);for(let it of items){let draw=async(kind,ww,hh,offy=0)=>{let im=new Image();im.src=pictures[kind];try{await im.decode()}catch(e){return}ctx.drawImage(im,-ww/2,-hh/2+offy,ww,hh)};let ww=sizes[it.kind]*it.scale/100/100*750,hh=ww/ratios[it.kind];ctx.save();ctx.translate(it.x/100*750,it.y/100*900);ctx.rotate(it.angle*Math.PI/180);await draw(it.kind,ww,hh);if(it.ringKind!==null)await draw(it.ringKind,ww*.55,hh*.34,hh*.04);ctx.restore()}let a=document.createElement('a');a.download='DekoSchaetze-Wunschtisch.png';a.href=canvas.toDataURL('image/png');a.click()};$('save').onclick=saveImage;
$('inquiry').onsubmit=e=>{e.preventDefault();let recipient=$('recipient').value;let body=`Name: ${$('customer').value}
E-Mail: ${$('email').value}
Telefon: ${$('phone').value}
Datum: ${$('date').value}
Nachricht: ${$('message').value}

${summaryText()}

Bitte das gespeicherte Tischbild gegebenenfalls als Anhang ergänzen.`;window.location.href='mailto:'+encodeURIComponent(recipient)+'?subject='+encodeURIComponent('DekoSchätze – unverbindliche Anfrage')+'&body='+encodeURIComponent(body)};
render();</script></body></html>
